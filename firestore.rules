rules_version = '2';

// Deploy with:  firebase deploy --only firestore:rules
service cloud.firestore {
  match /databases/{database}/documents {

    // Users: each user can only read/write their own profile.
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // Maritime telemetry cache: public BMKG data.
    // Anyone may read (used as fallback when BMKG is down);
    // only signed-in users may write the latest snapshot.
    match /maritimeCache/{docId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}
